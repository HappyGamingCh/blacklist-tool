{
  "name": "tft-blacklist",
  "version": "1.0.3",
  "main": "app.js",
  "productName": "TFT Blacklist",
  "scripts": {
    "start": "electron .",
    "start-poe2": "cross-env poe2_mode=true electron .",
    "prebuild": "npm install && npm install --only=dev",
    "fix-config-poe2": "cross-env poe2_mode=true node changeConfig.js",
    "fix-config": "cross-env poe2_mode=false node changeConfig.js",
    "package:win": "electron-packager . TFT-Blacklist --icon views/tft.ico --platform=win32 --arch=x64 --out=dist --overwrite",
    "build": "echo process.env.poe2_mode = 'false'; > poever.js && npm run fix-config && npm run package:win",
    "build-poe2": "npm run prebuild && npm run fix-config-poe2 && echo process.env.poe2_mode = 'true'; > poever.js && electron-packager . TFT-Blacklist-poe2 --icon views/tft.ico --platform=win32 --arch=x64 --out=dist --overwrite"
  },
  "dependencies": {
    "axios": "^0.24.0",
    "cross-env": "^7.0.3",
    "electron-overlay-window": "^2.0.1",
    "jquery": "^3.6.0",
    "sane": "^5.0.1",
    "toastr": "^2.1.4",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "electron": "^13.1.6",
    "electron-packager": "^15.3.0"
  }
}
